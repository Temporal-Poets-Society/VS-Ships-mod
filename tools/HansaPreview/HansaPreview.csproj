<Project Sdk="Microsoft.NET.Sdk">
  <!-- Preview exporter: builds a design with the same construction core the mod compiles and
       writes a .glb and a self-contained WebGL viewer. No game assembly is loaded; textures are
       read from the installed game's assets. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>disable</Nullable>
    <RollForward>LatestMajor</RollForward>
    <UseAppHost>false</UseAppHost>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GamePath Condition="'$(GamePath)' == ''">$(VINTAGE_STORY)</GamePath>
    <GamePath Condition="'$(GamePath)' == ''">$(APPDATA)\Vintagestory</GamePath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="..\..\src\Construction\**\*.cs" />
    <Reference Include="Newtonsoft.Json"><HintPath>$(GamePath)\Lib\Newtonsoft.Json.dll</HintPath></Reference>
  </ItemGroup>
</Project>
