<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- VS 1.22 runs on .NET 10. Building with the .NET 8 SDK works as long as we compile
         against the installed .NET 10 runtime assemblies instead of the .NET 8 reference pack. -->
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Hansa</AssemblyName>
    <RootNamespace>Hansa</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\mod\</OutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <EnableDefaultItems>false</EnableDefaultItems>
    <VintageStoryPath Condition="'$(VintageStoryPath)' == ''">$(VINTAGE_STORY)</VintageStoryPath>
    <VintageStoryPath Condition="'$(VintageStoryPath)' == ''">$(APPDATA)\Vintagestory</VintageStoryPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\**\*.cs" />
  </ItemGroup>

  <!-- Compile against the game's own .NET runtime (10.x) so the game DLLs' references line up. -->
  <PropertyGroup>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <NetCoreRuntimeDir>$([System.IO.Directory]::GetDirectories('$(NetCoreRoot)shared\Microsoft.NETCore.App', '10.*')[0])</NetCoreRuntimeDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(NetCoreRuntimeDir)\System.*.dll" Exclude="$(NetCoreRuntimeDir)\System.Private.*.dll;$(NetCoreRuntimeDir)\System.IO.Compression.Native.dll" Private="false" />
    <Reference Include="$(NetCoreRuntimeDir)\System.Private.CoreLib.dll" Private="false" />
    <Reference Include="$(NetCoreRuntimeDir)\netstandard.dll" Private="false" />
    <Reference Include="$(NetCoreRuntimeDir)\mscorlib.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="VintagestoryAPI"><HintPath>$(VintageStoryPath)\VintagestoryAPI.dll</HintPath><Private>false</Private></Reference>
    <!-- VintagestoryLib: working blocks aboard (ShipBlocks) subclass the engine's movable mini-dimension -->
    <Reference Include="VintagestoryLib"><HintPath>$(VintageStoryPath)\VintagestoryLib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="VSEssentials"><HintPath>$(VintageStoryPath)\Mods\VSEssentials.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="VSSurvivalMod"><HintPath>$(VintageStoryPath)\Mods\VSSurvivalMod.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(VintageStoryPath)\Lib\Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="protobuf-net"><HintPath>$(VintageStoryPath)\Lib\protobuf-net.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(VintageStoryPath)\Lib\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <!-- Cairo: the firehearth's dialog draws vanilla's flame and arrow as vanilla's firepit dialog does -->
    <Reference Include="cairo-sharp"><HintPath>$(VintageStoryPath)\Lib\cairo-sharp.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- The Sea mod (wind, waves, the water shaders). Uses the existing Sea build; this project never builds or changes Sea. -->
  <ItemGroup>
    <Reference Include="Sea"><HintPath>..\Sea\bin\$(Configuration)\mod\Sea.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="modinfo.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- (the user, 18 October 2026) the release carries the caravel, not the carracks: their ship files stay in the repo
       (tests read them, and work on the carrack resumes later) but are left out of the Release build. -->
  <PropertyGroup>
    <CarrackAssets>assets\hansa\config\ships\carrack*.json;assets\hansa\config\ships\hansa-carrack.json;assets\hansa\config\shipmeshes\carrack*.json;assets\hansa\config\shipmeshes\hansa-carrack.json;assets\hansa\shapes\entity\ship\carrack*\**;assets\hansa\shapes\entity\ship\hansa-carrack\**;assets\hansa\entities\ship\carrack*.json;assets\hansa\entities\ship\hansa-carrack.json</CarrackAssets>
  </PropertyGroup>
  <ItemGroup Condition="'$(Configuration)' != 'Release'">
    <None Include="assets\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <None Include="assets\**\*" Exclude="$(CarrackAssets)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- a Release build starts from an empty output folder, so files left out are not packed from an earlier build -->
  <Target Name="CleanModOutput" BeforeTargets="BeforeBuild" Condition="'$(Configuration)' == 'Release'">
    <RemoveDir Directories="$(OutputPath)" />
  </Target>

  <!-- Release build also produces a ready-to-install zip in .\release, named with the version from modinfo.json
       (release\hansa-0.2.0.zip); older zips there are removed. -->
  <PropertyGroup>
    <ModVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\modinfo.json')), '"version"\s*:\s*"([^"]+)"').Groups[1].Value)</ModVersion>
  </PropertyGroup>
  <Target Name="PackageMod" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <Error Condition="'$(ModVersion)' == ''" Text="No version found in modinfo.json" />
    <MakeDir Directories="$(MSBuildProjectDirectory)\release" />
    <ZipDirectory SourceDirectory="$(OutputPath)" DestinationFile="$(MSBuildProjectDirectory)\release\hansa-$(ModVersion).zip" Overwrite="true" />
  </Target>

</Project>
