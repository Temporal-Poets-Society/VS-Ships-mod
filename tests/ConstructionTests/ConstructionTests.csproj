<Project Sdk="Microsoft.NET.Sdk">
  <!-- Plain .NET checks of the ship construction core. Compiles src/Construction directly,
       so no game assembly is loaded; only the game's Newtonsoft.Json is referenced. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>disable</Nullable>
    <RollForward>LatestMajor</RollForward>
    <UseAppHost>false</UseAppHost>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GamePath Condition="'$(GamePath)' == ''">$(VINTAGE_STORY)</GamePath>
    <GamePath Condition="'$(GamePath)' == ''">$(APPDATA)\Vintagestory</GamePath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="..\..\src\Construction\**\*.cs" />
    <Reference Include="Newtonsoft.Json"><HintPath>$(GamePath)\Lib\Newtonsoft.Json.dll</HintPath></Reference>
  </ItemGroup>
</Project>
