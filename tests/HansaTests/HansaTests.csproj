<Project Sdk="Microsoft.NET.Sdk">
  <!-- Offline checks of ship collision, walking, frame math and riding the waves against the real carrack definition.
       Runs on the game's .NET 10 runtime (same trick as the mod: compile against its runtime assemblies). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RollForward>LatestMajor</RollForward>
    <UseAppHost>false</UseAppHost>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <EnableDefaultItems>false</EnableDefaultItems>
    <VintageStoryPath Condition="'$(VintageStoryPath)' == ''">$(VINTAGE_STORY)</VintageStoryPath>
    <VintageStoryPath Condition="'$(VintageStoryPath)' == ''">$(APPDATA)\Vintagestory</VintageStoryPath>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <NetCoreRuntimeDir>$([System.IO.Directory]::GetDirectories('$(NetCoreRoot)shared\Microsoft.NETCore.App', '10.*')[0])</NetCoreRuntimeDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="ModularTests.cs" />
    <Compile Include="StairTests.cs" />
    <Compile Include="DamageTests.cs" />
    <Compile Include="FloodReport.cs" />
    <Compile Include="DamageSkinTests.cs" />
    <Compile Include="CannonTests.cs" />
    <Compile Include="LayTests.cs" />
    <Compile Include="WreckTests.cs" />
    <Compile Include="NoteTests.cs" />
    <Compile Include="NoteTests0328.cs" />
    <Compile Include="HearthTests.cs" />
    <Compile Include="ChalkTextTests.cs" />
    <Compile Include="PumpTests.cs" />
    <Compile Include="OvenTests.cs" />
    <Compile Include="SailTests.cs" />
    <Compile Include="RainTests.cs" />
    <Compile Include="PartitionTests.cs" />
    <Compile Include="PartitionGapTests.cs" />
    <Compile Include="SailPressTests.cs" />
    <Compile Include="NoteTests0324.cs" />
    <Compile Include="NoteTests0325.cs" />
    <Compile Include="NoteTests0327.cs" />
    <Compile Include="NoteTests0328Hood.cs" />
    <Compile Include="NoteTests0328Damage.cs" />
    <Compile Include="NoteTests0329.cs" />
    <Compile Include="NoteTests0330.cs" />
    <Compile Include="..\..\src\Ship\CellDamage.cs" Link="Ship\CellDamage.cs" />
